{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/skills/writing-th/scripts/check_draft_preconditions.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking writing-th blueprint gate & ledger guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.agents/skills/writing-th/scripts/post_draft_lint.mjs\"",
            "timeout": 30,
            "statusMessage": "Linting Thai draft..."
          }
        ]
      }
    ]
  }
}
