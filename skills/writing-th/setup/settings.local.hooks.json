{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/writing-th/scripts/check_draft_preconditions.py",
            "timeout": 15,
            "statusMessage": "Checking argument-map gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/skills/writing-th/scripts/post_draft_lint.py",
            "timeout": 30,
            "statusMessage": "Linting Thai draft..."
          }
        ]
      }
    ]
  }
}
